# Copy to .env.local for local development. On Vercel, set these in Project Settings.

# Public: shown on the site and used to encrypt reports. From `npm run keys`.
NEXT_PUBLIC_PLATFORM_PUBLIC_KEY=
NEXT_PUBLIC_SITE_NAME=POSH Watch Maharashtra
NEXT_PUBLIC_CONTACT_EMAIL=

# Secret: never prefix these with NEXT_PUBLIC_.
ADMIN_TOKEN=          # 32+ characters, from `npm run keys`
POW_SECRET=           # from `npm run keys`
DATABASE_URL=         # set automatically when you connect Neon in Vercel > Storage
# POW_DIFFICULTY=15   # higher = slower for reporters and spammers alike
